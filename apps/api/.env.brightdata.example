# ============================================================================
# Bright Data 배치 설정 (서버 폐지 → 주중 2회 배치 전환)
#
# 실제 계정 조건(2026-08-08 대시보드 확인):
#   - zone 이름: 77 / 유형: SERP API (전체 JSON) / 단가: CPM당 $1.5 (= $1.5 / 1,000 요청)
#   - 계정 지출 한도: 월 $10 (대시보드에서 설정됨) ← 최종 안전장치. 여기서 물리적으로 막힌다.
#   - 무료 티어: 계정당 월 5,000 요청 공유 풀(SERP·Web Unlocker 공유). 계정 인증 후 활성.
#
# 비용 시나리오:
#   무료 활성 + 월 5,000 사용  → $0
#   무료 미활성(전부 종량제)     → 5,000 × $1.5/1000 = $7.5  (대시보드 $10 한도 안)
#   폭주 시                      → 대시보드 한도 $10 에서 강제 차단
# ============================================================================

# --- 인증 ---
# Bright Data API 키. 절대 코드/커밋에 넣지 말 것 (공개 저장소 사고 전례 있음).
LEWORD_BRIGHTDATA_API_KEY=
# 사용할 zone 이름 (대시보드의 "이름" 컬럼 값)
LEWORD_BRIGHTDATA_ZONE=77
# 다계정 회계용 라벨. 계정을 늘리지 않으면 primary 유지.
LEWORD_BRIGHTDATA_ACCOUNT=primary

# --- 예산 상한 (src/utils/brightdata-quota-governor.ts) ---
# 무료 공유 풀. 이 값에 닿으면 배치가 스스로 멈춘다.
LEWORD_BRIGHTDATA_FREE_CEILING=5000
# 무료를 넘어 허용할 유료 초과분. 0 = 무료 안에서만 동작(권장).
# 대시보드 $10 한도가 별도로 있으므로 여기서까지 열어줄 이유가 없다.
LEWORD_BRIGHTDATA_PAID_OVERAGE=0

# --- 기능별 상한 (한 기능이 5,000 을 독식하지 못하게) ---
# 주 2회 × 월 8~9배치 기준, 배치당 합계 약 550~580 요청.
#   golden    2000 : 급상승 조기신호 보드 (핵심)
#   affiliate 1500 : 제휴 커머스 + 연예인/방송 제품 조기포착
#   mindmap    700 : 문맥확장·연관키워드 (합성조합 → 실제 연관질의 교체분)
#   related      0 : mindmap 버킷에 통합 운용
#   youtube      0 : Bright Data 미사용. 공식 YouTube Data API(무료 10,000유닛/일) 사용
#   other      800 : 재시도·예비 버퍼
LEWORD_BRIGHTDATA_FEATURE_CAPS={"golden":2000,"affiliate":1500,"mindmap":700,"youtube":0,"other":800}

# --- 사용량 상태 파일 (프로세스 간 공유 카운터) ---
# 미설정 시 LEWORD_SERVER_USER_DATA / LEWORD_MOBILE_DATA_DIR / OS 임시폴더 순으로 결정.
# 배치가 컨테이너/스케줄러로 나뉘어 돌면 반드시 같은 경로를 공유해야 카운트가 맞는다.
LEWORD_BRIGHTDATA_QUOTA_STATE_FILE=

# ============================================================================
# YouTube Data API 쿼터 (src/utils/youtube-quota-governor.ts)
#
# Bright Data 예산과 별개. 공식 무료 쿼터는 프로젝트당 하루 10,000 "유닛"이고
# search.list = 100유닛, videos.list = 1유닛 으로 100배 차이다.
# searchYouTubeVideos() 는 최대 10페이지 페이지네이션 → 1회 실행에 최대 1,000유닛.
# 즉 10회면 하루치가 사라지고 403 quotaExceeded 로 유튜브 기능 전체가 죽는다.
# 아래 소프트 상한에서 미리 멈춘다(실한도 10,000까지 1,000유닛 여유).
# ============================================================================
LEWORD_YOUTUBE_DAILY_UNITS=10000
LEWORD_YOUTUBE_SOFT_CEILING=9000
LEWORD_YOUTUBE_QUOTA_STATE_FILE=
